# Netlify FREE web profile. Example only; enter real values in server settings.
# Use both Builds and Functions scopes. Never commit a filled copy.
APP_ENV=production
APP_ROLE=web
APP_URL=https://YOUR-SITE.netlify.app
NEXT_PUBLIC_APP_URL=https://YOUR-SITE.netlify.app
AUTH_ENABLED=true
FIREBASE_PROJECT_ID=dukaanpilot-9d403
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dukaanpilot-9d403
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dukaanpilot-9d403.firebaseapp.com
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_PUBLIC_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_PUBLIC_WEB_APP_ID
# Paste compact JSON into this SERVER secret in Netlify, without shell quotes.
# For a local dotenv file, wrap the complete JSON in single quotes.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Neon runtime connection: pooled hostname, certificate verification required.
DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Set direct migration URL only in the operator's ignored production env file.
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
AI_ENABLED=true
AI_LIVE_DATA_ENABLED=true
AI_REVIEW_REFERENCE=docs/AI_SETUP_AND_EVALUATION.md#owner-directed-business-mode--1-november-2026
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
AI_INPUT_PRICE_USD_PER_MILLION=0.30
AI_OUTPUT_PRICE_USD_PER_MILLION=2.50
WHATSAPP_OUTBOUND_ENABLED=false
WHATSAPP_PAID_TEMPLATES_ENABLED=false
FOLLOW_UP_ENABLED=false
# Omit FIREBASE_AUTH_EMULATOR_HOST, NEXT_DIST_DIR and all Meta credentials.
# Remaining application caps use their bounded defaults in .env.example.
