# DukaanPilot environment contract — S1-S5 implementation.
# Next.js loads .env.local; copy this example there for local overrides.
# Provider adapters remain disabled until their account/review prerequisites pass.
# Never commit real keys, tenant tokens, service-account JSON, or production URLs.
# Only NEXT_PUBLIC_ values are browser-visible; they must never contain secrets.

# [Core: S1] APP_ENV is independent from Next.js NODE_ENV. Local npm run build
# and npm start may use development mode. Real deployments must set production
# and explicit HTTPS URLs. Actual deployment and pilot prerequisites remain open.
APP_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Karachi
BUSINESS_CURRENCY=PKR

# PostgreSQL connection string supplied through local secret file/secret manager.
# Include provider-required TLS parameters in deployed environments.
DATABASE_URL=
# Optional direct (non-pooler) URL for migration commands only; server uses DATABASE_URL.
DIRECT_DATABASE_URL=

# [Authentication: Firebase Auth]
# Use the public configuration from your own Firebase web app.
# Server credentials should use workload identity/ADC where possible, not JSON in env.
AUTH_PROVIDER=firebase
AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
# Optional on non-Google hosts: single-line service-account JSON in SERVER secrets.
# Must match FIREBASE_PROJECT_ID. Never put it in NEXT_PUBLIC_ variables or Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# The Firebase web API key/config above is intentionally public. Admin secrets
# and database URLs must never use NEXT_PUBLIC_ names. Analytics is not enabled.
# Optional official Auth emulator, loopback only; forbidden when APP_ENV or
# NODE_ENV is production. Leave blank for the real Firebase Google provider.
FIREBASE_AUTH_EMULATOR_HOST=

# [Gemini: S4] Server-only key and evaluated, pinned model ID.
# Blank model disables AI until an approved available model is selected.
# Key alone does not prove eligible credit or paid-service data terms.
AI_ENABLED=false
AI_REVIEW_REFERENCE=
GEMINI_API_KEY=
GEMINI_MODEL_ID=
AI_LIVE_DATA_ENABLED=false
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_CALLS_PER_INSTRUCTION=2
AI_TIMEOUT_MS=15000
AI_MAX_TEXT_CHARACTERS=2000

# Internal USD estimate caps, independent of product AI-action quotas.
# Reserve worst-case cost atomically; config is not a provider billing guarantee.
AI_GLOBAL_DAILY_BUDGET_USD=1.00
AI_GLOBAL_MONTHLY_BUDGET_USD=25.00
AI_TENANT_DAILY_BUDGET_USD=0.10
AI_TENANT_MONTHLY_BUDGET_USD=2.00
# Fill with the selected model's dated rates; blank rates disable paid AI dispatch.
AI_INPUT_PRICE_USD_PER_MILLION=
AI_OUTPUT_PRICE_USD_PER_MILLION=

# [Meta: S5] App-wide secrets, distinct verification versus signing roles.
# One pilot app token covers operator-provisioned dedicated per-tenant numbers.
# Phone-number IDs/Graph version/review reference belong in WhatsAppConnection.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_REVIEW_REFERENCE=
WHATSAPP_OUTBOUND_ENABLED=false
WHATSAPP_PAID_TEMPLATES_ENABLED=false

# [Jobs: S5/S6] Durable database worker; same schema/source, separate process.
# npm run worker (continuous) or npm run worker -- --once (one bounded tick).
APP_ROLE=web
# Free Netlify profile sets false: no always-running worker is provisioned.
FOLLOW_UP_ENABLED=true
WORKER_POLL_INTERVAL_MS=5000
JOB_MAX_ATTEMPTS=3
WORKFLOW_MAX_CHECKS=3
WORKFLOW_MAX_OWNER_REMINDERS=2
WORKFLOW_MAX_CUSTOMER_UPDATES=1
WORKFLOW_MAX_LIFETIME_HOURS=72
WORKFLOW_MIN_REMINDER_INTERVAL_HOURS=12
QUIET_HOURS_START=21:00
QUIET_HOURS_END=09:00
PROPOSAL_TTL_HOURS=24

# [Operations: S7] Retention assumptions require review before live use.
# Financial/consent/audit retention is policy-specific, not controlled by body TTL.
MESSAGE_BODY_RETENTION_DAYS=30
LOG_LEVEL=info
ERROR_TRACKING_DSN=
OPERATOR_ID=
OPERATOR_REVIEW_REFERENCE=
BACKUP_KEY_ID=
# Server secret: 32 random bytes encoded as base64; store separately from backups.
BACKUP_ENCRYPTION_KEY_BASE64=
RESTORE_DATABASE_URL=
RESTORE_REVIEW_REFERENCE=
# Reserved until the owner chooses a real support destination/monitoring provider.
SUPPORT_CONTACT_EMAIL=

# Startup validation rejects malformed flags, expanded limits and missing reviews.
# Paid templates stay disabled: the pilot allocation is zero. Free-form sends
# outside the recipient's 24-hour window fall back to the dashboard.
# Service replies also stop at 900 attempts over rolling 33 UTC days per number.
# Check Meta's current free allowance and use a dedicated/test number; this app
# cannot account for messages sent by other apps on the same number.

