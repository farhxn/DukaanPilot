{
  "name": "dukaanpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "deployment:check": "node --experimental-strip-types scripts/deployment-check.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/config.test.ts tests/deployment.test.ts tests/client-api.test.ts tests/validation.test.ts tests/money.test.ts tests/ai.test.ts tests/instruction-date.test.ts tests/language.test.ts tests/whatsapp.test.ts tests/workflow.test.ts tests/revocation.test.ts",
    "test:integration": "node scripts/test-db.mjs",
    "local:db": "node scripts/local-db.mjs",
    "local:auth": "firebase emulators:start --only auth --project demo-dukaanpilot --config firebase.json",
    "local:test-server": "node scripts/s2-test-server.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "worker": "node --conditions=react-server --experimental-strip-types scripts/worker.mjs",
    "test:restore": "node scripts/restore-rehearsal.mjs",
    "backup": "node --experimental-strip-types scripts/backup.mjs",
    "operator": "node --conditions=react-server --experimental-strip-types scripts/operator.mjs",
    "restore": "node scripts/restore.mjs",
    "whatsapp:check": "node scripts/whatsapp-readiness.mjs"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "1.14.7",
    "rimraf@>=4.2.0": {
      "glob": "14.0.3"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-icons": "1.3.2",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "geist": "1.9.0",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "15.34.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
